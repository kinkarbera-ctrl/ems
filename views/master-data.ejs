<script>
(function(){

    function getCurrentMasterType(){

        if (typeof currentType !== "undefined" && currentType) {
            return String(currentType).toLowerCase();
        }

        if (window.currentType) {
            return String(window.currentType).toLowerCase();
        }

        const active =
            document.querySelector(
                ".module-card.active,.master-card.active,.module-item.active,.master-item.active"
            );

        if(active){

            const value =
                active.dataset.type ||
                active.dataset.module ||
                active.getAttribute("data-type");

            if(value) return String(value).toLowerCase();
        }

        const selected =
            document.querySelector(
                "select#masterType,select#moduleType"
            );

        if(selected && selected.value){
            return String(selected.value).toLowerCase();
        }

        return "";
    }
    window.downloadMasterTemplate = function(){

        const type = currentMaster || "department";

        window.location.href =
            "/api/master-data/" +
            encodeURIComponent(type) +
            "/template";
    };


        type = map[type] || type;

        window.location.href =
            "/api/master-data/" +
            encodeURIComponent(type) +
            "/template";
    };


    function addTemplateButtons(){

        const buttons =
            Array.from(document.querySelectorAll("button"));

        buttons.forEach(function(importButton){

            const text =
                (importButton.innerText || "").trim().toLowerCase();

            if(!text.includes("import excel")) return;

            const parent = importButton.parentElement;

            if(!parent) return;

            if(parent.querySelector(".btn-template-auto")) return;

            const btn =
                document.createElement("button");

            btn.type = "button";
            btn.className = "btn-template-auto";
            btn.innerHTML = "📄 Template";

            btn.onclick = function(){

                let type =
                    importButton.dataset.type ||
                    importButton.dataset.module ||
                    getCurrentMasterType();

                downloadMasterTemplate(type);
            };

            importButton.insertAdjacentElement(
                "afterend",
                btn
            );
        });
    }


    function addTemplateMenu(){

        if(document.getElementById("templateMenuAuto"))
            return;

        const menu =
            document.createElement("div");

        menu.id = "templateMenuAuto";
        menu.className = "template-menu-auto";

        menu.innerHTML = `
            <button onclick="downloadMasterTemplate('department')">
                🏢 Department Template
            </button>

            <button onclick="downloadMasterTemplate('designation')">
                📋 Designation Template
            </button>

            <button onclick="downloadMasterTemplate('location')">
                📍 Location Template
            </button>

            <button onclick="downloadMasterTemplate('employee')">
                👤 Employee Template
            </button>

            <button onclick="downloadMasterTemplate('phone')">
                ☎ Phone Template
            </button>

            <button onclick="downloadMasterTemplate('switch')">
                🔌 Switch Template
            </button>
        `;

        menu.style.display = "none";

        document.body.appendChild(menu);
    }


    document.addEventListener("DOMContentLoaded",function(){

        addTemplateButtons();
        addTemplateMenu();

        setTimeout(addTemplateButtons,500);
        setTimeout(addTemplateButtons,1200);
    });

})();
</script>




