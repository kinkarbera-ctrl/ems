<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>EMS - Master Data</title>

<link rel="stylesheet" href="/style.css">

<style>

*{
    box-sizing:border-box;
}

body{
    margin:0;
    background:#f4f6f9;
    color:#1f2937;
    font-family:Segoe UI,Arial,sans-serif;
}

.master-page{
    padding:28px 32px;
}

.master-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:25px;
}

.master-header h1{
    margin:0;
    font-size:26px;
    font-weight:700;
    color:#172033;
}

.master-header p{
    margin:6px 0 0;
    color:#8a94a6;
    font-size:12px;
}

.master-options{
    display:grid;
    grid-template-columns:repeat(6,1fr);
    gap:12px;
    margin-bottom:22px;
}

.master-option{
    border:1px solid #e1e6ed;
    background:#fff;
    border-radius:12px;
    padding:17px 12px;
    cursor:pointer;
    text-align:left;
    transition:.18s;
}

.master-option:hover{
    border-color:#b8c9e9;
    transform:translateY(-1px);
}

.master-option.active{
    border-color:#4f83df;
    background:#f1f6ff;
}

.option-icon{
    width:36px;
    height:36px;
    border-radius:9px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:#f0f4fa;
    color:#52657f;
    font-size:16px;
    margin-bottom:12px;
}

.master-option.active .option-icon{
    background:#dce9ff;
    color:#2864d7;
}

.option-title{
    font-size:11px;
    font-weight:700;
    color:#344054;
}

.option-sub{
    margin-top:4px;
    font-size:9px;
    color:#98a2b3;
}

.data-area{
    background:#fff;
    border:1px solid #e1e6ed;
    border-radius:13px;
    overflow:hidden;
}

.data-header{
    padding:19px 21px;
    border-bottom:1px solid #edf0f4;
}

.data-title{
    font-size:15px;
    font-weight:700;
    color:#202b3c;
}

.data-description{
    margin-top:4px;
    font-size:10px;
    color:#98a2b3;
}

.toolbar{
    padding:13px 17px;
    border-bottom:1px solid #edf0f4;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:12px;
}

.search-box{
    width:330px;
    height:38px;
    border:1px solid #dfe4eb;
    background:#f9fafb;
    border-radius:8px;
    padding:0 13px;
    outline:none;
    font-size:11px;
}

.search-box:focus{
    background:#fff;
    border-color:#7ba5e8;
}

.toolbar-buttons{
    display:flex;
    gap:7px;
}

.btn{
    height:36px;
    padding:0 14px;
    border:1px solid #dce2ea;
    background:#fff;
    color:#475467;
    border-radius:7px;
    cursor:pointer;
    font-size:10px;
    font-weight:650;
}

.btn:hover{
    background:#f7f9fc;
}

.btn-primary{
    background:#2864d7;
    border-color:#2864d7;
    color:#fff;
}

.table-wrap{
    overflow:auto;
}

table{
    width:100%;
    border-collapse:collapse;
    min-width:850px;
}

thead th{
    background:#f8fafc;
    height:43px;
    padding:0 16px;
    text-align:left;
    color:#7b8798;
    font-size:9px;
    letter-spacing:.4px;
    border-bottom:1px solid #e8ecf1;
}

tbody td{
    padding:12px 16px;
    border-bottom:1px solid #f0f2f5;
    font-size:11px;
    color:#667085;
}

tbody tr:hover{
    background:#fafcff;
}

.id-cell{
    color:#344054;
    font-weight:700;
}

.status{
    display:inline-block;
    padding:5px 9px;
    border-radius:20px;
    font-size:9px;
    font-weight:700;
}

.active-status{
    background:#eaf8f0;
    color:#16834b;
}

.inactive-status{
    background:#fff0f1;
    color:#d92d20;
}

.action{
    border:1px solid #dfe4eb;
    background:#fff;
    width:29px;
    height:29px;
    border-radius:6px;
    cursor:pointer;
    margin-right:4px;
}

.edit{
    color:#2864d7;
}

.delete{
    color:#d92d20;
}

.empty{
    text-align:center;
    padding:55px 20px !important;
    color:#98a2b3 !important;
}

.modal-bg{
    display:none;
    position:fixed;
    inset:0;
    background:rgba(15,23,42,.35);
    align-items:center;
    justify-content:center;
    z-index:9999;
}

.modal{
    width:520px;
    max-width:94%;
    background:#fff;
    border-radius:14px;
    padding:24px;
    box-shadow:0 20px 50px rgba(0,0,0,.15);
}

.modal h2{
    margin:0 0 18px;
    font-size:18px;
}

.form-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px;
}

.form-group{
    display:flex;
    flex-direction:column;
    gap:5px;
}

.form-group.full{
    grid-column:1/-1;
}

.form-group label{
    font-size:10px;
    color:#667085;
    font-weight:650;
}

.form-group input,
.form-group select{
    height:37px;
    border:1px solid #dfe4eb;
    border-radius:7px;
    padding:0 10px;
    outline:none;
}

.modal-buttons{
    display:flex;
    justify-content:flex-end;
    gap:8px;
    margin-top:20px;
}

@media(max-width:1100px){

    .master-options{
        grid-template-columns:repeat(3,1fr);
    }

}

@media(max-width:700px){

    .master-page{
        padding:18px;
    }

    .master-options{
        grid-template-columns:repeat(2,1fr);
    }

    .toolbar{
        flex-direction:column;
        align-items:stretch;
    }

    .search-box{
        width:100%;
    }

    .toolbar-buttons{
        flex-wrap:wrap;
    }

    .form-grid{
        grid-template-columns:1fr;
    }

}


.template-btn{
    background:#f7f4ff !important;
    border-color:#d9ccff !important;
    color:#6941c6 !important;
    font-weight:700;
}

.template-btn:hover{
    background:#eee9ff !important;
    border-color:#b8a4ff !important;
}
</style>

<style>
.btn-template-auto{
    display:inline-flex;
    align-items:center;
    gap:7px;
    height:38px;
    padding:0 14px;
    border:1px solid #d9d1ff;
    border-radius:10px;
    background:#f7f4ff;
    color:#6941c6;
    font-size:12px;
    font-weight:700;
    cursor:pointer;
    transition:.2s;
}

.btn-template-auto:hover{
    background:#ede9fe;
    border-color:#a78bfa;
    transform:translateY(-1px);
}

.template-menu-auto{
    position:fixed;
    right:25px;
    bottom:25px;
    z-index:9999;
    background:white;
    border:1px solid #e5e7eb;
    border-radius:14px;
    padding:8px;
    box-shadow:0 12px 35px rgba(0,0,0,.12);
}

.template-menu-auto button{
    display:block;
    width:210px;
    padding:10px 12px;
    border:0;
    background:white;
    text-align:left;
    border-radius:9px;
    cursor:pointer;
    font-size:12px;
}

.template-menu-auto button:hover{
    background:#f5f3ff;
    color:#6941c6;
}

.template-btn{
    background:#f7f4ff !important;
    border-color:#d9ccff !important;
    color:#6941c6 !important;
    font-weight:700;
}

.template-btn:hover{
    background:#eee9ff !important;
    border-color:#b8a4ff !important;
}
</style>
</head>

<body>

<div class="ems-layout">

<aside class="sidebar">

    <div class="brand">
        <div class="brand-logo">EMS</div>

        <div>
            <div class="brand-title">Employee</div>
            <div class="brand-subtitle">Management System</div>
        </div>
    </div>

    <div class="menu-title">MAIN MENU</div>

    <a href="/dashboard" class="menu-item">
        <span class="menu-icon">⌂</span>
        <span>Dashboard</span>
    </a>

    <a href="/employees" class="menu-item">
        <span class="menu-icon">♙</span>
        <span>Employee Master</span>
    </a>

    <a href="/phones" class="menu-item">
        <span class="menu-icon">☎</span>
        <span>Phone Master</span>
    </a>

    <a href="/switches" class="menu-item">
        <span class="menu-icon">▣</span>
        <span>Switch Master</span>
    </a>

    <a href="/master-data" class="menu-item active">
        <span class="menu-icon">▤</span>
        <span>Master Data</span>
    </a>

    <div class="sidebar-bottom">

        <div class="system-status">
            <span class="status-dot"></span>
            System Online
        </div>

        <div class="version">
            EMS v1.0
        </div>

    </div>

</aside>


<main class="main-content">

<header class="topbar">

    <div>
        <div class="page-title">Master Data</div>
        <div class="page-subtitle">
            Central master information
        </div>
    </div>

    <div class="admin-box">

        <div class="admin-avatar">A</div>

        <div>
            <div class="admin-name">Administrator</div>
            <div class="admin-role">System Admin</div>
        </div>

    </div>

</header>


<section class="master-page">

    <div class="master-header">

        <div>
            <h1>Master Data</h1>
            <p>
                Manage all EMS master information from one workspace
            </p>
        </div>

    </div>


    <div class="master-options">

        <button class="master-option active"
            onclick="changeMaster('department',this)">
            <div class="option-icon">▦</div>
            <div class="option-title">Department</div>
            <div class="option-sub">Department Master</div>
        </button>

        <button class="master-option"
            onclick="changeMaster('designation',this)">
            <div class="option-icon">◈</div>
            <div class="option-title">Designation</div>
            <div class="option-sub">Designation Master</div>
        </button>

        <button class="master-option"
            onclick="changeMaster('location',this)">
            <div class="option-icon">⌖</div>
            <div class="option-title">Location</div>
            <div class="option-sub">Location Master</div>
        </button>

        <button class="master-option"
            onclick="changeMaster('employee',this)">
            <div class="option-icon">♙</div>
            <div class="option-title">Employee</div>
            <div class="option-sub">Employee Master</div>
        </button>

        <button class="master-option"
            onclick="changeMaster('phone',this)">
            <div class="option-icon">☎</div>
            <div class="option-title">Phone</div>
            <div class="option-sub">Phone Master</div>
        </button>

        <button class="master-option"
            onclick="changeMaster('switch',this)">
            <div class="option-icon">▣</div>
            <div class="option-title">Switch</div>
            <div class="option-sub">Switch Master</div>
        </button>

    </div>


    <div class="data-area">

        <div class="data-header">

            <div class="data-title" id="dataTitle">
                Department Master
            </div>

            <div class="data-description" id="dataDescription">
                Manage department records
            </div>

        </div>


        <div class="toolbar">

            <input
                type="text"
                id="masterSearch"
                class="search-box"
                placeholder="Search records..."
                oninput="searchTable()">

            <div class="toolbar-buttons">

                <button class="btn btn-primary"
                    onclick="addRecord()">
                    + Add New
                </button>

                <button class="btn"
                    onclick="importData()">
                    ↑ Import Excel
                </button>

                <button class="btn"
                    onclick="exportData()">
                    ↓ Export Excel
                </button>

                <button class="btn template-btn"
                    onclick="downloadMasterTemplate()">
                    📄 Template
                </button>

            </div>

        </div>


        <div class="table-wrap">

            <table>

                <thead id="tableHead"></thead>

                <tbody id="tableBody"></tbody>

            </table>

        </div>

    </div>

</section>

</main>

</div>


<!-- MODAL -->

<div class="modal-bg" id="modalBg">

    <div class="modal">

        <h2 id="modalTitle">Add Record</h2>

        <div id="modalForm"></div>

        <div class="modal-buttons">

            <button class="btn"
                onclick="closeModal()">
                Cancel
            </button>

            <button class="btn btn-primary"
                onclick="saveRecord()">
                Save
            </button>

        </div>

    </div>

</div>


<script>

let currentMaster = "department";
let editingId = null;


const masterInfo = {

    department:{
        title:"Department Master",
        description:"Manage department records"
    },

    designation:{
        title:"Designation Master",
        description:"Manage designation records"
    },

    location:{
        title:"Location Master",
        description:"Manage location records"
    },

    employee:{
        title:"Employee Master",
        description:"Manage employee records"
    },

    phone:{
        title:"Phone Master",
        description:"Manage phone records"
    },

    switch:{
        title:"Switch Master",
        description:"Manage network switch records"
    }

};


function esc(value){

    if(value === null || value === undefined){
        return "";
    }

    return String(value)
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");
}


function changeMaster(type,button){

    currentMaster = type;

    editingId = null;

    document
        .querySelectorAll(".master-option")
        .forEach(function(item){
            item.classList.remove("active");
        });

    button.classList.add("active");

    document.getElementById("dataTitle").innerText =
        masterInfo[type].title;

    document.getElementById("dataDescription").innerText =
        masterInfo[type].description;

    document.getElementById("masterSearch").value = "";

    function downloadMasterTemplate(){

    const type = currentMaster;

    window.location.href =
        "/api/master-data/" +
        encodeURIComponent(type) +
        "/template";
}
loadData();
}


async function loadData(){

    const head = document.getElementById("tableHead");
    const body = document.getElementById("tableBody");

    body.innerHTML = `
        <tr>
            <td class="empty" colspan="15">
                Loading records...
            </td>
        </tr>
    `;

    try{

        const response = await fetch(
            "/api/master-data/" +
            encodeURIComponent(currentMaster)
        );

        const result = await response.json();

        if(!response.ok || !result.success){
            throw new Error(
                result.message || "Unable to load records."
            );
        }

        renderTable(result.data || []);

    }
    catch(error){

        body.innerHTML = `
            <tr>
                <td class="empty" colspan="15">
                    ${esc(error.message)}
                </td>
            </tr>
        `;
    }
}


function renderTable(data){

    const head = document.getElementById("tableHead");
    const body = document.getElementById("tableBody");


    if(!data.length){

        buildHeaders();

        body.innerHTML = `
            <tr>
                <td class="empty" colspan="15">
                    No records found
                </td>
            </tr>
        `;

        return;
    }


    if(currentMaster === "department"){

        head.innerHTML = `
            <tr>
                <th>ID</th>
                <th>DEPARTMENT NAME</th>
                <th>STATUS</th>
                <th>ACTION</th>
            </tr>
        `;

        body.innerHTML = data.map(function(row){

            return `
                <tr>
                    <td class="id-cell">${esc(row.DepartmentId)}</td>
                    <td>${esc(row.DepartmentName)}</td>
                    <td>${statusHtml(row.IsActive)}</td>
                    <td>
                        <button class="action edit"
                            onclick='editRecord(${JSON.stringify(row)})'>✎</button>
                        <button class="action delete"
                            onclick="deleteRecord(${row.DepartmentId})">×</button>
                    </td>
                </tr>
            `;

        }).join("");

    }


    else if(currentMaster === "designation"){

        head.innerHTML = `
            <tr>
                <th>ID</th>
                <th>DESIGNATION NAME</th>
                <th>STATUS</th>
                <th>ACTION</th>
            </tr>
        `;

        body.innerHTML = data.map(function(row){

            return `
                <tr>
                    <td class="id-cell">${esc(row.DesignationId)}</td>
                    <td>${esc(row.DesignationName)}</td>
                    <td>${statusHtml(row.IsActive)}</td>
                    <td>
                        <button class="action edit"
                            onclick='editRecord(${JSON.stringify(row)})'>✎</button>
                        <button class="action delete"
                            onclick="deleteRecord(${row.DesignationId})">×</button>
                    </td>
                </tr>
            `;

        }).join("");

    }


    else if(currentMaster === "location"){

        head.innerHTML = `
            <tr>
                <th>ID</th>
                <th>LOCATION NAME</th>
                <th>ADDRESS</th>
                <th>STATUS</th>
                <th>ACTION</th>
            </tr>
        `;

        body.innerHTML = data.map(function(row){

            return `
                <tr>
                    <td class="id-cell">${esc(row.LocationId)}</td>
                    <td>${esc(row.LocationName)}</td>
                    <td>${esc(row.Address)}</td>
                    <td>${statusHtml(row.IsActive)}</td>
                    <td>
                        <button class="action edit"
                            onclick='editRecord(${JSON.stringify(row)})'>✎</button>
                        <button class="action delete"
                            onclick="deleteRecord(${row.LocationId})">×</button>
                    </td>
                </tr>
            `;

        }).join("");

    }


    else if(currentMaster === "employee"){

        head.innerHTML = `
            <tr>
                <th>ID</th>
                <th>EMPLOYEE CODE</th>
                <th>EMPLOYEE NAME</th>
                <th>DEPARTMENT</th>
                <th>DESIGNATION</th>
                <th>EMAIL</th>
                <th>MOBILE</th>
                <th>ACTION</th>
            </tr>
        `;

        body.innerHTML = data.map(function(row){

            return `
                <tr>
                    <td class="id-cell">${esc(row.ID)}</td>
                    <td>${esc(row.EMP_CODE)}</td>
                    <td>${esc(row.EMP_NAME)}</td>
                    <td>${esc(row.DEPARTMENT)}</td>
                    <td>${esc(row.DESIGNATION)}</td>
                    <td>${esc(row.EMAIL)}</td>
                    <td>${esc(row.MOBILE_NO)}</td>
                    <td>
                        <button class="action edit"
                            onclick='editRecord(${JSON.stringify(row)})'>✎</button>
                        <button class="action delete"
                            onclick="deleteRecord(${row.ID})">×</button>
                    </td>
                </tr>
            `;

        }).join("");

    }


    else if(currentMaster === "phone"){

        head.innerHTML = `
            <tr>
                <th>ID</th>
                <th>EMPLOYEE CODE</th>
                <th>EMPLOYEE NAME</th>
                <th>MOBILE</th>
                <th>PHONE</th>
                <th>EXTENSION</th>
                <th>ACTION</th>
            </tr>
        `;

        body.innerHTML = data.map(function(row){

            return `
                <tr>
                    <td class="id-cell">${esc(row.Id)}</td>
                    <td>${esc(row.EmployeeCode)}</td>
                    <td>${esc(row.EmployeeName)}</td>
                    <td>${esc(row.Mobile)}</td>
                    <td>${esc(row.Phone)}</td>
                    <td>${esc(row.Extension)}</td>
                    <td>
                        <button class="action edit"
                            onclick='editRecord(${JSON.stringify(row)})'>✎</button>
                        <button class="action delete"
                            onclick="deleteRecord(${row.Id})">×</button>
                    </td>
                </tr>
            `;

        }).join("");

    }


    else if(currentMaster === "switch"){

        head.innerHTML = `
            <tr>
                <th>ID</th>
                <th>SWITCH NAME</th>
                <th>LOCATION</th>
                <th>IP ADDRESS</th>
                <th>VENDOR</th>
                <th>MODEL</th>
                <th>STATUS</th>
                <th>ACTION</th>
            </tr>
        `;

        body.innerHTML = data.map(function(row){

            return `
                <tr>
                    <td class="id-cell">${esc(row.id)}</td>
                    <td>${esc(row.switchName)}</td>
                    <td>${esc(row.location)}</td>
                    <td>${esc(row.ipAddress)}</td>
                    <td>${esc(row.vendor)}</td>
                    <td>${esc(row.model)}</td>
                    <td>${esc(row.status)}</td>
                    <td>
                        <button class="action edit"
                            onclick='editRecord(${JSON.stringify(row)})'>✎</button>
                        <button class="action delete"
                            onclick="deleteRecord(${row.id})">×</button>
                    </td>
                </tr>
            `;

        }).join("");
    }
}


function buildHeaders(){

    const head = document.getElementById("tableHead");

    if(currentMaster === "department"){
        head.innerHTML = `
            <tr>
                <th>ID</th>
                <th>DEPARTMENT NAME</th>
                <th>STATUS</th>
                <th>ACTION</th>
            </tr>`;
    }

    else if(currentMaster === "designation"){
        head.innerHTML = `
            <tr>
                <th>ID</th>
                <th>DESIGNATION NAME</th>
                <th>STATUS</th>
                <th>ACTION</th>
            </tr>`;
    }

    else if(currentMaster === "location"){
        head.innerHTML = `
            <tr>
                <th>ID</th>
                <th>LOCATION NAME</th>
                <th>ADDRESS</th>
                <th>STATUS</th>
                <th>ACTION</th>
            </tr>`;
    }

    else if(currentMaster === "employee"){
        head.innerHTML = `
            <tr>
                <th>ID</th>
                <th>EMPLOYEE CODE</th>
                <th>EMPLOYEE NAME</th>
                <th>DEPARTMENT</th>
                <th>DESIGNATION</th>
                <th>EMAIL</th>
                <th>MOBILE</th>
                <th>ACTION</th>
            </tr>`;
    }

    else if(currentMaster === "phone"){
        head.innerHTML = `
            <tr>
                <th>ID</th>
                <th>EMPLOYEE CODE</th>
                <th>EMPLOYEE NAME</th>
                <th>MOBILE</th>
                <th>PHONE</th>
                <th>EXTENSION</th>
                <th>ACTION</th>
            </tr>`;
    }

    else if(currentMaster === "switch"){
        head.innerHTML = `
            <tr>
                <th>ID</th>
                <th>SWITCH NAME</th>
                <th>LOCATION</th>
                <th>IP ADDRESS</th>
                <th>VENDOR</th>
                <th>MODEL</th>
                <th>STATUS</th>
                <th>ACTION</th>
            </tr>`;
    }
}


function statusHtml(value){

    const active =
        value === true ||
        value === 1 ||
        value === "1";

    return active
        ? '<span class="status active-status">Active</span>'
        : '<span class="status inactive-status">Inactive</span>';
}


