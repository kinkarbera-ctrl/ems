function importData(){

    const input =
        document.createElement("input");

    input.type = "file";
    input.accept = ".xlsx,.xls";

    input.onchange = async function(){

        const file = input.files[0];

        if(!file){
            return;
        }

        const formData =
            new FormData();

        formData.append("file",file);
        formData.append("type",currentMaster);


        try{

            const response = await fetch(
                "/api/master-data/" + encodeURIComponent(currentMaster) + "/import",
                {
                    method:"POST",
                    body:formData
                }
            );


            const result =
                await response.json();


            if(!response.ok || !result.success){

                alert(
                    "Import Failed\n\n" +
                    (result.message || "")
                );

                return;
            }


            let msg =
                "Excel Import Completed\n\n" +
                "Total   : " + result.total + "\n" +
                "Imported: " + result.imported + "\n" +
                "Skipped : " + result.skipped;


            if(result.errors &&
               result.errors.length){

                msg +=
                    "\n\nDetails:\n" +
                    result.errors
                    .slice(0,10)
                    .join("\n");
            }


            alert(msg);

            await function downloadMasterTemplate(){

    const type = currentMaster;

    window.location.href =
        "/api/master-data/" +
        encodeURIComponent(type) +
        "/template";
}
loadData();

        }
        catch(error){

            alert(
                "Import Error\n\n" +
                error.message
            );
        }

    };

    input.click();
}


