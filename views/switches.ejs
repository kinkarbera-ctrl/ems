}

/* TABLE CARD */

.switch-table-card {
    overflow: hidden;

    background: rgba(255,255,255,.94);

    border: 1px solid #e2e8ef;
    border-radius: 18px;

    box-shadow: 0 12px 35px rgba(20,40,60,.12);
}

/* TABLE */

.switch-table {
    width: 100%;
    border-collapse: collapse;
}

.switch-table thead {
    background: #183b5d;
}

.switch-table th {
    padding: 14px 13px;

    color: white;

    font-size: 11px;
    font-weight: 700;

    text-align: left;
    white-space: nowrap;

    letter-spacing: .4px;
}

.switch-table td {
    padding: 13px;

    color: #344054;

    font-size: 12px;

    border-bottom: 1px solid #edf0f3;
}

.switch-table tbody tr {
    transition: .18s ease;
}

.switch-table tbody tr:hover {
    background: #f4f8fb;
}

/* SWITCH NAME */

.switch-name {
    font-weight: 700;
    color: #173f63;
}

.switch-location {
    color: #667085;
    font-size: 11px;
    margin-top: 3px;
}

/* IP */

.switch-ip {
    display: inline-block;

    padding: 5px 9px;

    border-radius: 7px;

    background: #edf5fa;
    color: #205b80;

    font-family: Consolas, monospace;
    font-size: 11px;
}

/* STATUS */

.switch-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;

    padding: 5px 10px;

    border-radius: 20px;

    background: #edf8f1;
    color: #18794e;

    font-size: 10px;
    font-weight: 700;
}

.switch-status::before {
    content: "";

    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: #22a06b;

    box-shadow: 0 0 0 3px rgba(34,160,107,.12);
}

/* BUTTONS */

.switch-action {
    display: inline-flex;
    align-items: center;
    gap: 5px;

    padding: 7px 11px;

    border-radius: 8px;

    border: 1px solid #d9e2ec;

    background: white;

    color: #35516b;

    font-size: 11px;
    font-weight: 600;

    cursor: pointer;

    transition: .18s ease;
}

.switch-action:hover {
    transform: translateY(-1px);

    background: #edf5fa;

    border-color: #9bbbd0;
}

.switch-action.delete {
    color: #b42318;
}

.switch-action.delete:hover {
    background: #fff1f0;
    border-color: #f0aaa5;
}

/* EMPTY */

.switch-empty {
    padding: 55px 20px;

    text-align: center;
    color: #667085;
}

.switch-empty-icon {
    font-size: 38px;
    margin-bottom: 10px;
}

/* RESPONSIVE */

@media(max-width:900px) {

    .switch-page {
        padding: 12px;
    }

    .switch-toolbar {
        flex-direction: column;
        align-items: flex-start;
    }

    .switch-table-card {
        overflow-x: auto;
    }

    .switch-table {
        min-width: 950px;
    }
}
</style>

</style>

<div id="switchEditOverlay" class="switch-edit-overlay">

    <div class="switch-edit-modal">

        <div class="switch-edit-header">

            <div>
                <h2 class="switch-edit-title">Edit Switch</h2>
                <div class="switch-edit-subtitle">
                    Update switch configuration details
                </div>
            </div>

            <button
                type="button"
                class="switch-edit-close"
                onclick="closeSwitchEdit()">
                ×
            </button>

        </div>

        <form id="switchEditForm">

            <div class="switch-edit-body">

                <div class="switch-edit-grid">

                    <div class="switch-edit-field">
                        <label>Switch Name</label>
                        <input id="editSwitchName" type="text">
                    </div>

                    <div class="switch-edit-field">
                        <label>Location</label>
                        <input id="editLocation" type="text">
                    </div>

                    <div class="switch-edit-field">
                        <label>IP Address</label>
                        <input id="editIpAddress" type="text">
                    </div>

                    <div class="switch-edit-field">
                        <label>Switch Type</label>
                        <input id="editSwitchType" type="text">
                    </div>

                    <div class="switch-edit-field">
                        <label>Switch Mode</label>
                        <input id="editSwitchMode" type="text">
                    </div>

                    <div class="switch-edit-field">
                        <label>Vendor</label>
                        <input id="editVendor" type="text">
                    </div>

                    <div class="switch-edit-field">
                        <label>Model</label>
                        <input id="editModel" type="text">
                    </div>

                    <div class="switch-edit-field">
                        <label>Serial No.</label>
                        <input id="editSerialNo" type="text">
                    </div>

                    <div class="switch-edit-field">
                        <label>Port Count</label>
                        <input id="editPortCount" type="number" min="0">
                    </div>

                    <div class="switch-edit-field">
                        <label>Rack</label>
                        <input id="editRack" type="text">
                    </div>

                    <div class="switch-edit-field">
                        <label>Status</label>
                        <select id="editStatus">
                            <option value="Active">Active</option>
                            <option value="Online">Online</option>
                            <option value="Inactive">Inactive</option>
                            <option value="Offline">Offline</option>
                        </select>
                    </div>

                    <div class="switch-edit-field full">
                        <label>Remarks</label>
                        <textarea id="editRemarks"></textarea>
                    </div>

                </div>

            </div>

            <div class="switch-edit-footer">

                <button
                    type="button"
                    class="switch-btn-cancel"
                    onclick="closeSwitchEdit()">
                    Cancel
                </button>

                <button
                    type="submit"
                    class="switch-btn-save">
                    Save Changes
                </button>

            </div>

        </form>

    </div>

</div>

<script>

let currentSwitchId = null;

function openSwitchEdit(button) {

    const row = button.closest("tr");

    if (!row) {
        alert("Switch record not found.");
        return;
    }

    const cells = row.querySelectorAll("td");

    currentSwitchId = cells[0].innerText.trim();

    document.getElementById("editSwitchName").value =
        cells[1].innerText.trim() === "-" ? "" : cells[1].innerText.trim();

    document.getElementById("editLocation").value =
        cells[2].innerText.trim() === "-" ? "" : cells[2].innerText.trim();

    document.getElementById("editIpAddress").value =
        cells[3].innerText.trim() === "-" ? "" : cells[3].innerText.trim();

    document.getElementById("editSwitchType").value =
        cells[4].innerText.trim() === "-" ? "" : cells[4].innerText.trim();

    document.getElementById("editSwitchMode").value =
        cells[5].innerText.trim() === "-" ? "" : cells[5].innerText.trim();

    document.getElementById("editVendor").value =
        cells[6].innerText.trim() === "-" ? "" : cells[6].innerText.trim();

    document.getElementById("editModel").value =
        cells[7].innerText.trim() === "-" ? "" : cells[7].innerText.trim();

    document.getElementById("editSerialNo").value =
        cells[8].innerText.trim() === "-" ? "" : cells[8].innerText.trim();

    document.getElementById("editPortCount").value =
        cells[9].innerText.trim() === "-" ? "" : cells[9].innerText.trim();

    document.getElementById("editRack").value =
        cells[10].innerText.trim() === "-" ? "" : cells[10].innerText.trim();

    document.getElementById("editStatus").value =
        cells[11].innerText.trim() || "Active";

    document.getElementById("editRemarks").value = "";

    document.getElementById("switchEditOverlay").classList.add("show");

    document.getElementById("editSwitchName").focus();
}

function closeSwitchEdit() {

    document
        .getElementById("switchEditOverlay")
        .classList.remove("show");

    currentSwitchId = null;
}

document
    .getElementById("switchEditOverlay")
    .addEventListener("click", function(e) {

        if (e.target === this) {
            closeSwitchEdit();
        }

    });

document
    .getElementById("switchEditForm")
    .addEventListener("submit", async function(e) {

        e.preventDefault();

        if (!currentSwitchId) {
            alert("Invalid Switch ID.");
            return;
        }

        const saveButton =
            this.querySelector(".switch-btn-save");

        saveButton.disabled = true;
        saveButton.innerText = "Saving...";

        try {

            const response = await fetch(
                "/api/switches/" + currentSwitchId,
                {
                    method: "PUT",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({

                        switchName:
                            document.getElementById("editSwitchName").value,

                        location:
                            document.getElementById("editLocation").value,

                        ipAddress:
                            document.getElementById("editIpAddress").value,

                        switchType:
                            document.getElementById("editSwitchType").value,

                        switchMode:
                            document.getElementById("editSwitchMode").value,

                        vendor:
                            document.getElementById("editVendor").value,

                        model:
                            document.getElementById("editModel").value,

                        serialNo:
                            document.getElementById("editSerialNo").value,

                        portCount:
                            document.getElementById("editPortCount").value,

                        rack:
                            document.getElementById("editRack").value,

                        status:
                            document.getElementById("editStatus").value,

                        remarks:
                            document.getElementById("editRemarks").value

                    })
                }
            );

            const result = await response.json();

            if (!result.success) {
                alert(result.message || "Update failed.");
                return;
            }

            closeSwitchEdit();

            location.reload();

        } catch (error) {

            alert("Update Error: " + error.message);

        } finally {

            saveButton.disabled = false;
            saveButton.innerText = "Save Changes";

        }

    });

</script>
</body>
</html>



