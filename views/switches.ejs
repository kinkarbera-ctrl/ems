<body>

<div class="ems-layout">

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <div class="brand">
            <div class="brand-logo">EMS</div>

            <div>
                <div class="brand-title">Employee</div>
                <div class="brand-subtitle">Management System</div>
            </div>
        </div>

        <div class="menu-title">MAIN MENU</div>

        <a href="/dashboard" class="menu-item">
            <span class="menu-icon">⌂</span>
            <span>Dashboard</span>
        </a>

        <a href="/employees" class="menu-item">
            <span class="menu-icon">♙</span>
            <span>Employee Master</span>
        </a>

        <a href="/phones" class="menu-item">
            <span class="menu-icon">☎</span>
            <span>Phone Master</span>
        </a>

        <a href="/switches" class="menu-item active">
            <span class="menu-icon">▣</span>
            <span>Switch Master</span>
        </a>

        <a href="/master-data" class="menu-item">
            <span class="menu-icon">▤</span>
            <span>Master Data</span>
        </a>

        <div class="sidebar-bottom">
            <div class="system-status">
                <span class="status-dot"></span>
                System Online
            </div>

            <div class="version">
                EMS v1.0
            </div>
        </div>

    </aside>


    <!-- MAIN -->
    <main class="main-content">

        <!-- TOP BAR -->
        <header class="topbar">

            <div>
                <div class="page-title">Switch Master</div>

                <div class="page-subtitle">
                    Network switch and port information
                </div>
            </div>

            <div class="user-box">

                <div class="user-avatar">
                    A
                </div>

                <div>
                    <div class="user-name">
                        Administrator
                    </div>

                    <div class="user-role">
                        System Admin
                    </div>
                </div>

            </div>

        </header>


        <!-- PAGE -->
        <section class="switch-page">

            <div class="switch-head">

                <div>
                    <h1>Switch Master</h1>

                    <p>
                        Manage network switch inventory and configuration
                    </p>
                </div>

                <button class="switch-btn primary">
                    + Add Switch
                </button>

            </div>


            <!-- TOOLBAR -->
            <div class="switch-toolbar">

                <input
                    id="switchSearch"
                    class="switch-search"
                    type="text"
                    placeholder="Search switch, location, IP, vendor..."
                >

                <div class="switch-actions">

                    <button class="switch-btn">
                        ↓ Export Excel
                    </button>

                    <button class="switch-btn">
                        ↑ Import Excel
                    </button>

                    <button class="switch-btn">
                        Refresh
                    </button>

                </div>

            </div>


            <!-- TABLE -->
            <div class="switch-panel">

                <div class="switch-panel-head">

                    <div>
                        <div class="switch-panel-title">
                            Network Switch Records
                        </div>

                        <div class="switch-panel-sub">
                            Switch inventory and configuration details
                        </div>
                    </div>

                    <div class="switch-count">
                        <%= switches ? switches.length : 0 %> Records
                    </div>

                </div>


                <div class="switch-table-wrap">

                    <table class="switch-table" id="switchTable">

                        <thead>

                            <tr>
                                <th>ID</th>
                                <th>SWITCH NAME</th>
                                <th>LOCATION</th>
                                <th>IP ADDRESS</th>
                                <th>TYPE</th>
                                <th>MODE</th>
                                <th>VENDOR</th>
                                <th>MODEL</th>
                                <th>SERIAL NO</th>
                                <th>PORTS</th>
                                <th>RACK</th>
                                <th>STATUS</th>
                                <th>ACTION</th>
                            </tr>

                        </thead>


                        <tbody>

                        <% if (switches && switches.length > 0) { %>

                            <% switches.forEach(function(sw) { %>

                            <tr>

                                <td>
                                    <%= sw.id || "-" %>
                                </td>

                                <td class="switch-name-cell">
                                    <%= sw.switchName || "-" %>
                                </td>

                                <td>
                                    <%= sw.location || "-" %>
                                </td>

                                <td>
                                    <span class="switch-ip">
                                        <%= sw.ipAddress || "-" %>
                                    </span>
                                </td>

                                <td class="switch-type">
                                    <%= sw.switchType || "-" %>
                                </td>

                                <td>
                                    <%= sw.switchMode || "-" %>
                                </td>

                                <td>
                                    <%= sw.vendor || "-" %>
                                </td>

                                <td>
                                    <%= sw.model || "-" %>
                                </td>

                                <td>
                                    <%= sw.serialNo || "-" %>
                                </td>

                                <td>
                                    <%= sw.portCount || "-" %>
                                </td>

                                <td>
                                    <%= sw.rack || "-" %>
                                </td>

                                <td>

                                    <% 
                                        const status =
                                            String(sw.status || "Active")
                                            .toLowerCase();
                                    %>

                                    <% if (
                                        status === "active" ||
                                        status === "online"
                                    ) { %>

                                        <span class="switch-status">
                                            <%= sw.status || "Active" %>
                                        </span>

                                    <% } else if (
                                        status === "offline" ||
                                        status === "inactive"
                                    ) { %>

                                        <span class="switch-status offline">
                                            <%= sw.status %>
                                        </span>

                                    <% } else { %>

                                        <span class="switch-status unknown">
                                            <%= sw.status || "Unknown" %>
                                        </span>

                                    <% } %>

                                </td>

                                <td>

                                    <div class="switch-action">

                                        <button
                                            title="Edit"
                                            type="button"
                                            onclick="openSwitchEdit(this)">
                                            ✎
                                        </button>

                                        <button
                                            title="Delete"
                                            type="button"
                                            onclick="deleteSwitch(<%= sw.id %>, '<%= String(sw.switchName || "").replace(/'/g, "\\'") %>')">
                                            ×
                                        </button>

                                    </div>

                                </td>

                            </tr>

                            <% }); %>

                        <% } else { %>

                            <tr>
                                <td colspan="13">
                                    <div class="switch-empty">
                                        No switch records found
                                    </div>
                                </td>
                            </tr>

                        <% } %>

                        </tbody>

                    </table>

                </div>

            </div>

        </section>

    </main>

</div>


<script>

const switchSearch =
    document.getElementById("switchSearch");

switchSearch.addEventListener("input", function () {

    const searchValue =
        this.value.toLowerCase().trim();

    const rows =
        document.querySelectorAll(
            "#switchTable tbody tr"
        );

    rows.forEach(function (row) {

        const text =
            row.innerText.toLowerCase();

        row.style.display =
            text.includes(searchValue)
                ? ""
                : "none";

    });

});

</script>

<script>

async function deleteSwitch(id, name) {

    if (!confirm(
        "Delete switch \"" + name + "\" ?\n\nThis action cannot be undone."
    )) {
        return;
    }

    try {

        const response = await fetch(
            "/api/master-data/switch/" + id,
            {
                method: "DELETE"
            }
        );

        const result = await response.json();

        if (!result.success) {
            alert(result.message || "Delete failed.");
            return;
        }

        alert("Switch deleted successfully.");
        location.reload();

    } catch (error) {

        alert("Delete Error: " + error.message);

    }
}

</script>
<style>

.switch-edit-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.48);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    padding: 24px;
}

.switch-edit-overlay.show {
    display: flex;
}

.switch-edit-modal {
    width: min(900px, 96vw);
    max-height: 92vh;
    overflow-y: auto;
    background: #ffffff;
    border-radius: 18px;
    box-shadow: 0 25px 70px rgba(15, 23, 42, 0.25);
    animation: switchModalIn .18s ease-out;
}

@keyframes switchModalIn {
    from {
        opacity: 0;
        transform: translateY(15px) scale(.98);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.switch-edit-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 26px;
    border-bottom: 1px solid #e5e7eb;
}

.switch-edit-title {
    margin: 0;
    font-size: 21px;
    font-weight: 700;
    color: #172033;
}

.switch-edit-subtitle {
    margin-top: 4px;
    font-size: 13px;
    color: #7b8494;
}

.switch-edit-close {
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 10px;
    background: #f3f4f6;
    color: #475569;
    font-size: 22px;
    cursor: pointer;
}

.switch-edit-close:hover {
    background: #e5e7eb;
}

.switch-edit-body {
    padding: 24px 26px;
}

.switch-edit-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
}

.switch-edit-field {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.switch-edit-field.full {
    grid-column: 1 / -1;
}

.switch-edit-field label {
    font-size: 12px;
    font-weight: 700;
    color: #475569;
}

.switch-edit-field input,
.switch-edit-field select,
.switch-edit-field textarea {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid #d7dce5;
    border-radius: 9px;
    padding: 11px 12px;
    font-size: 14px;
    color: #172033;
    background: #fff;
    outline: none;
    transition: .15s;
}

.switch-edit-field input:focus,
.switch-edit-field select:focus,
.switch-edit-field textarea:focus {
    border-color: #64748b;
    box-shadow: 0 0 0 3px rgba(100, 116, 139, .10);
}

.switch-edit-field textarea {
    min-height: 85px;
    resize: vertical;
}

.switch-edit-footer {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    padding: 18px 26px;
    border-top: 1px solid #e5e7eb;
    background: #fafbfc;
    border-radius: 0 0 18px 18px;
}

.switch-btn-cancel,
.switch-btn-save {
    border: 0;
    border-radius: 9px;
    padding: 11px 20px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
}

.switch-btn-cancel {
    background: #eef0f3;
    color: #475569;
}

.switch-btn-save {
    background: #172033;
    color: #fff;
}

.switch-btn-save:hover {
    background: #0f172a;
}

@media (max-width: 700px) {
    .switch-edit-grid {
        grid-template-columns: 1fr;
    }

    .switch-edit-field.full {
        grid-column: auto;
    }

    .switch-edit-modal {
        max-height: 95vh;
    }
}


