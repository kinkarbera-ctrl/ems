<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EMS - Switch Master</title>

    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/inner-pages.css">

    <style>
        .switch-page {
            padding: 26px 32px 40px;
            background: #f4f7fb;
            min-height: calc(100vh - 82px);
        }

        .switch-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 22px;
        }

        .switch-head h1 {
            margin: 0;
            font-size: 23px;
            color: #172033;
        }

        .switch-head p {
            margin: 5px 0 0;
            color: #8b95a7;
            font-size: 12px;
        }

        .switch-toolbar {
            background: #fff;
            border: 1px solid #e3e8ef;
            border-radius: 12px;
            padding: 13px 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 18px;
            gap: 12px;
        }

        .switch-search {
            width: 320px;
            height: 40px;
            border: 1px solid #dfe5ed;
            border-radius: 8px;
            outline: none;
            padding: 0 14px;
            background: #f9fafc;
            color: #344054;
            font-size: 12px;
        }

        .switch-search:focus {
            background: #fff;
            border-color: #8db5ee;
            box-shadow: 0 0 0 3px #edf4ff;
        }

        .switch-actions {
            display: flex;
            gap: 8px;
        }

        .switch-btn {
            height: 38px;
            border-radius: 8px;
            padding: 0 14px;
            border: 1px solid #dfe5ed;
            background: #fff;
            color: #475467;
            cursor: pointer;
            font-size: 11px;
            font-weight: 650;
        }

        .switch-btn:hover {
            background: #f6f8fb;
        }

        .switch-btn.primary {
            border-color: #2563eb;
            background: #2563eb;
            color: #fff;
        }

        .switch-btn.primary:hover {
            background: #1d4ed8;
        }

        .switch-panel {
            background: #fff;
            border: 1px solid #e3e8ef;
            border-radius: 12px;
            overflow: hidden;
        }

        .switch-panel-head {
            height: 66px;
            padding: 0 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #edf0f4;
        }

        .switch-panel-title {
            font-size: 14px;
            font-weight: 700;
            color: #273244;
        }

        .switch-panel-sub {
            margin-top: 3px;
            font-size: 10px;
            color: #98a2b3;
        }

        .switch-count {
            background: #eef4ff;
            color: #2563eb;
            padding: 6px 10px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 700;
        }

        .switch-table-wrap {
            overflow-x: auto;
        }

        .switch-table {
            width: 100%;
            min-width: 1200px;
            border-collapse: collapse;
        }

        .switch-table th {
            height: 44px;
            padding: 0 15px;
            text-align: left;
            background: #f8fafc;
            border-bottom: 1px solid #e8ecf1;
            color: #7b8798;
            font-size: 9px;
            font-weight: 750;
            letter-spacing: .5px;
            white-space: nowrap;
        }

        .switch-table td {
            height: 54px;
            padding: 8px 15px;
            border-bottom: 1px solid #f0f2f5;
            color: #667085;
            font-size: 11px;
            white-space: nowrap;
        }

        .switch-table tbody tr:hover {
            background: #f8fbff;
        }

        .switch-name-cell {
            font-weight: 700;
            color: #344054;
        }

        .switch-ip {
            display: inline-block;
            padding: 5px 8px;
            border-radius: 5px;
            background: #f3f6fa;
            color: #52647b;
            font-family: Consolas, monospace;
            font-size: 10px;
        }

        .switch-type {
            color: #475467;
            font-weight: 600;
        }

        .switch-status {
            display: inline-block;
            padding: 5px 9px;
            border-radius: 20px;
            background: #ecfdf3;
            color: #16834b;
            font-size: 9px;
            font-weight: 700;
        }

        .switch-status.offline {
            background: #fff1f2;
            color: #d92d20;
        }

        .switch-status.unknown {
            background: #f2f4f7;
            color: #667085;
        }

        .switch-action {
            display: flex;
            gap: 6px;
        }

        .switch-action button {
            width: 30px;
            height: 29px;
            border-radius: 6px;
            border: 1px solid #e2e7ee;
            background: #fff;
            cursor: pointer;
            color: #667085;
        }

        .switch-action button:hover {
            background: #f4f7fb;
        }

        .switch-empty {
            padding: 55px;
            text-align: center;
            color: #98a2b3;
            font-size: 12px;
        }

        @media (max-width: 800px) {
            .switch-page {
                padding: 20px;
            }

            .switch-head,
            .switch-toolbar {
                align-items: flex-start;
                flex-direction: column;
            }

            .switch-search {
                width: 100%;
            }

            .switch-actions {
                width: 100%;
            }
        }
    
<style>
/* =========================================================
   SWITCH MASTER - PREMIUM NETWORK UI
   ========================================================= */

.switch-page {
    padding: 22px;
}

/* HEADER */

.switch-hero {
    position: relative;
    overflow: hidden;

    padding: 25px 30px;
    margin-bottom: 20px;

    border-radius: 20px;

    background:
        linear-gradient(
            120deg,
            rgba(18,48,78,.96),
            rgba(42,86,120,.90)
        );

    color: white;

    box-shadow: 0 12px 30px rgba(18,48,78,.25);
}

.switch-hero::after {
    content: "NETWORK";
    position: absolute;
    right: 25px;
    top: 18px;

    font-size: 55px;
    font-weight: 800;

    color: rgba(255,255,255,.06);
    letter-spacing: 5px;
}

.switch-hero h1 {
    margin: 0;
    font-size: 28px;
    font-weight: 700;
}

.switch-hero p {
    margin: 7px 0 0;
    color: rgba(255,255,255,.78);
    font-size: 13px;
}

/* TOOLBAR */

.switch-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;

    margin-bottom: 18px;
    padding: 15px 18px;

    background: rgba(255,255,255,.92);

    border: 1px solid #e4e9ef;
    border-radius: 15px;

    box-shadow: 0 7px 22px rgba(20,40,60,.09);
}

.switch-toolbar-title {
    display: flex;
    align-items: center;
    gap: 10px;

    color: #183b5d;
    font-weight: 700;
}

.switch-network-icon {
    width: 38px;
    height: 38px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 11px;

    background: #eaf2f8;
    color: #1e587d;

    font-size: 19px;
}

/* TABLE CARD */

.switch-table-card {
    overflow: hidden;

    background: rgba(255,255,255,.94);

    border: 1px solid #e2e8ef;
    border-radius: 18px;

    box-shadow: 0 12px 35px rgba(20,40,60,.12);
}

/* TABLE */

.switch-table {
    width: 100%;
    border-collapse: collapse;
}

.switch-table thead {
    background: #183b5d;
}

.switch-table th {
    padding: 14px 13px;

    color: white;

    font-size: 11px;
    font-weight: 700;

    text-align: left;
    white-space: nowrap;

    letter-spacing: .4px;
}

.switch-table td {
    padding: 13px;

    color: #344054;

    font-size: 12px;

    border-bottom: 1px solid #edf0f3;
}

.switch-table tbody tr {
    transition: .18s ease;
}

.switch-table tbody tr:hover {
    background: #f4f8fb;
}

/* SWITCH NAME */

.switch-name {
    font-weight: 700;
    color: #173f63;
}

.switch-location {
    color: #667085;
    font-size: 11px;
    margin-top: 3px;
}

/* IP */

.switch-ip {
    display: inline-block;

    padding: 5px 9px;

    border-radius: 7px;

    background: #edf5fa;
    color: #205b80;

    font-family: Consolas, monospace;
    font-size: 11px;
}

/* STATUS */

.switch-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;

    padding: 5px 10px;

    border-radius: 20px;

    background: #edf8f1;
    color: #18794e;

    font-size: 10px;
    font-weight: 700;
}

.switch-status::before {
    content: "";

    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: #22a06b;

    box-shadow: 0 0 0 3px rgba(34,160,107,.12);
}

/* BUTTONS */

.switch-action {
    display: inline-flex;
    align-items: center;
    gap: 5px;

    padding: 7px 11px;

    border-radius: 8px;

    border: 1px solid #d9e2ec;

    background: white;

    color: #35516b;

    font-size: 11px;
    font-weight: 600;

    cursor: pointer;

    transition: .18s ease;
}

.switch-action:hover {
    transform: translateY(-1px);

    background: #edf5fa;

    border-color: #9bbbd0;
}

.switch-action.delete {
    color: #b42318;
}

.switch-action.delete:hover {
    background: #fff1f0;
    border-color: #f0aaa5;
}

/* EMPTY */

.switch-empty {
    padding: 55px 20px;

    text-align: center;
    color: #667085;
}

.switch-empty-icon {
    font-size: 38px;
    margin-bottom: 10px;
}

/* RESPONSIVE */

@media(max-width:900px) {

    .switch-page {
        padding: 12px;
    }

    .switch-toolbar {
        flex-direction: column;
        align-items: flex-start;
    }

    .switch-table-card {
        overflow-x: auto;
    }

    .switch-table {
        min-width: 950px;
    }
}
</style>

</style>
